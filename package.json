{
  "name": "rimlab-pinsk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/process-images.mjs && vite",
    "build": "node scripts/process-images.mjs && vite build",
    "preview": "vite preview",
    "images:process": "node scripts/process-images.mjs",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md}\"",
